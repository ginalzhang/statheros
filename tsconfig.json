{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "*.config.ts"]
}
